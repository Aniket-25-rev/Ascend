<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Is_Core_Support_Bundle</name>
        <label>Is Core Support Bundle?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Other Product - Exit</defaultConnectorLabel>
        <rules>
            <name>Core_Support_SKU</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Product2.StockKeepingUnit</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>001-DESK-SVC-BNDL-CORE-001</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Run_Allocation</targetReference>
            </connector>
            <label>Core Support SKU</label>
        </rules>
    </decisions>
    <description>Allocates the Core Support bundle on initial configuration, when the root line and its component lines are inserted in the same transaction. Runs on an asynchronous path so the components exist before they are queried, and delegates to Core Support Allocate SKU Totals Sub. Exists separately from the update-triggered flow because an async path requires the Is Changed operator, which evaluates false on insert.</description>
    <environments>Default</environments>
    <interviewLabel>Core Support Allocate SKU Totals On Create {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core Support Allocate SKU Totals On Create</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ParentQuoteLineItemId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Quantity</field>
            <operator>GreaterThan</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <object>QuoteLineItem</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Is_Core_Support_Bundle</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Run_Allocation</name>
        <label>Run Allocation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Core_Support_Allocate_SKU_Totals_Sub</flowName>
        <inputAssignments>
            <name>varRootId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
