<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Child_Gross</name>
        <label>Add Child Gross To Running Total</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varTotalGross</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>frmChildGross</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Sum_Gross</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Stage_Child_Allocation</name>
        <label>Stage Child Allocation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varChildToUpdate.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Allocate.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varChildToUpdate.Bundle_Price_Display__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>frmChildBundlePrice</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varChildToUpdate.Total_Per_User_Per_SKU__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>frmChildAllocation</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varChildUpdates</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varChildToUpdate</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Allocate</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Stage_Root_Total</name>
        <label>Stage Root Line Total</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varRootToUpdate.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Root.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varRootToUpdate.Total_Per_User_Per_SKU__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Root.NetUnitPrice</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Root_Line</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Divisors_Are_Valid</name>
        <label>Are Divisors Greater Than Zero?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Zero Divisor - Skip Updates</defaultConnectorLabel>
        <rules>
            <name>Divisors_Positive</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varTotalGross</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Root.Quantity</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Allocate</targetReference>
            </connector>
            <label>Divisors Positive</label>
        </rules>
    </decisions>
    <description>Shared allocation logic for the Core Support bundle. Takes a bundle root QuoteLineItem Id, spreads the root NetUnitPrice across its component lines in proportion to gross extended list price, and writes each component&apos;s per-user gross list price. Called by the create-triggered and update-triggered Core Support Allocate SKU Totals flows so the logic lives in one place.</description>
    <environments>Default</environments>
    <formulas>
        <name>frmChildAllocation</name>
        <dataType>Currency</dataType>
        <expression>({!Loop_Allocate.ListPrice} * {!Loop_Allocate.Quantity} / {!varTotalGross}) * {!Get_Root.NetUnitPrice}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>frmChildBundlePrice</name>
        <dataType>Currency</dataType>
        <expression>({!Loop_Allocate.ListPrice} * {!Loop_Allocate.Quantity}) / {!Get_Root.Quantity}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>frmChildGross</name>
        <dataType>Number</dataType>
        <expression>{!Loop_Sum_Gross.ListPrice} * {!Loop_Sum_Gross.Quantity}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Core Support Allocate SKU Totals Sub {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Core Support Allocate SKU Totals Sub</label>
    <loops>
        <name>Loop_Allocate</name>
        <label>Loop Children - Allocate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Child_Lines</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Stage_Child_Allocation</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Child_Lines</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Sum_Gross</name>
        <label>Loop Children - Sum Gross</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Child_Lines</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Child_Gross</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Divisors_Are_Valid</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Child_Lines</name>
        <label>Get Bundle Component Lines</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Sum_Gross</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>QuoteId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Root.QuoteId</elementReference>
            </value>
        </filters>
        <filters>
            <field>ParentQuoteLineItemId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Root.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>QuoteLineItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Root</name>
        <label>Get Bundle Root Line</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Child_Lines</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varRootId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>QuoteLineItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Child_Lines</name>
        <label>Update Component Lines</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Stage_Root_Total</targetReference>
        </connector>
        <inputReference>varChildUpdates</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Root_Line</name>
        <label>Update Root Line Total</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>varRootToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Root</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>varChildToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>QuoteLineItem</objectType>
    </variables>
    <variables>
        <name>varChildUpdates</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>QuoteLineItem</objectType>
    </variables>
