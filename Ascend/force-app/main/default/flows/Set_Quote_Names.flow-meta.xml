        <label>Add to recordset</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Quotes2Add</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Thru_Quotes</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Thru_Quotes</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Ctr</name>
        <label>Set Ctr</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Counter</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Set_Name</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Name</name>
        <label>Set Name</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Loop_Thru_Quotes.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>QuoteName</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_to_recordset</targetReference>
        </connector>
    </assignments>
    <description>Flow that receives Opportunity and renames related Quotes</description>
    <environments>Default</environments>
    <formulas>
        <name>QuoteName</name>
        <dataType>String</dataType>
        <expression>{!Loop_Thru_Quotes.Opportunity.Name} &amp; &quot; - V&quot; &amp; TEXT({!Counter})</expression>
    </formulas>
    <interviewLabel>Set Quote Names {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Set Quote Names</label>
    <loops>
        <name>Loop_Thru_Quotes</name>
        <label>Loop Thru Quotes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Quotes</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Set_Ctr</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Quotes</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Quotes</name>
        <label>Get Quotes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Thru_Quotes</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>OpportunityId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Quote</object>
        <sortField>LastModifiedDate</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
