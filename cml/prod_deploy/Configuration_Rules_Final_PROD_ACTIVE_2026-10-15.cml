@(contextPath = "SalesTransaction.OriginalActionTypecml__c")
extern string OriginalActionTypeFormula = "";

@(contextPath = "SalesTransaction.Onboarding_Fee_Amortized__c")
extern string OnboardingFeeAmortized = "No";

@(contextPath = "SalesTransaction.Onboarding_Fee_Waived__c")
extern boolean OnboardingFeeWaived = false;

type LineItem;

// Bundle types
type ServiceDeskProductClass : LineItem {
    @(tagName = "SalesTransactionActionType", defaultValue = "")
    string lineActionType;

}

type serviceDeskOnboardingFee : LineItem;

type serviceDeskMonthlyOnboardingFeeMonthly : LineItem;

// ===================== CYBERSECURITY =====================
type CybersecurityProductClass : LineItem {
    @(tagName = "SalesTransactionActionType", defaultValue = "")
    string lineActionType;

    // AC-2: Quote Line Group Id of the line (one group per ramp year).

    @(tagName = "SalesTransactionItemGroup", defaultValue = "")
    string lineGroup;

    // AC-2: "true" when the line is in a ramped line group, else "false".

    @(tagName = "IsLineGroupRamped__std", defaultValue = "false")
    string lineGroupRamped;

    // NEW: total quantity after this transaction (Amend = start + change)

    @(tagName = "ItemEndQuantity", defaultValue = "0")
    decimal(2) endQty;

}

type CyberSecurityRenewal : LineItem {
    @(tagName = "SalesTransactionActionType", defaultValue = "")
    string lineActionType;

}

type cybersecurityOnboardingFee : LineItem;

type cybersecurityMonthlyOnboardingFee : LineItem;

// ===================== INFRASTRUCTURE =====================
type InfrastructureProductClass : LineItem {
    @(tagName = "SalesTransactionActionType", defaultValue = "")
    string lineActionType;

    // NEW: total quantity after this transaction (Amend = start + change)

    @(tagName = "ItemEndQuantity", defaultValue = "0")
    decimal(2) endQty;

}

type InfrastructureRenewal : LineItem {
    @(tagName = "SalesTransactionActionType", defaultValue = "")
    string lineActionType;

}

type infrastructureOnboardingFee : LineItem;

type infrastructureMonthlyOnboardingFee : LineItem;

// ===================== PRIVATE CLOUD =====================
type PrivateCloudProductClass : LineItem {
    @(tagName = "SalesTransactionActionType", defaultValue = "")
    string lineActionType;

}

type privateCloudOnboardingFee : LineItem;

type privateCloudMonthlyOnboardingFee : LineItem;

// ===================== CORE SUPPORT =====================
// Core Support - One-Time Onboarding Fee
type CoreSupportOneTimeOnboardingFee : LineItem;

// Core Support children that only had a classification-level type (need their own type for the bundle relation)
type AscendDefendSIEMServers : CybersecurityProductClass;

type PatchManagementDeviceMgmtPatchingServerLicensing : InfrastructureProductClass;

