<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>AscendLeadership</submitter>
        <type>roleSubordinatesInternal</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>CaseNumber</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Change_Management_Approvers</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Step 1</label>
        <name>Step_1</name>
    </approvalStep>
    <emailTemplate>unfiled$public/Case_Deployment_Approval_Request</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>ISPICKVAL(Status, &apos;Ready to Test&apos;) || (ISPICKVAL(Status, &apos;Assigned - In Progress&apos;) &amp;&amp;  ISPICKVAL(Project__r.Service__c, &apos;App&apos;) )</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Case_Deployment_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Case_Deployment_approved_or_Rejected</name>
            <type>Alert</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Case_Deployment_approved_or_Rejected</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Case_Development_in_Progress</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Case_Request_Submitted</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Case Deployment Approval Request</label>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Case_Deployment_Approval_Recalled</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Case_Development_in_Progress</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
