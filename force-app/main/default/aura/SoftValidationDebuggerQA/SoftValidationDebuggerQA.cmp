<aura:component implements="force:lightningQuickAction,force:hasRecordId">
    <aura:html tag="style">
        .panel.slds-modal .modal-body {
            padding: 0;
        }

        .slds-modal__container .cuf-content {
            padding:0!important;
        }

        .panel.slds-modal .baseDefault.forceChatterBasePublisher.forceChatterLightningComponent {
            height: 100%;
        }

        .modal-container.slds-modal__container {
            width: 80%;
            max-width: 80%;
        }

        .modal-container.slds-modal__container .forceChatterPublisherPresentationPanel,
        .modal-container.slds-modal__container .forceChatterPublisherPresentationPanel .container,
        .modal-container.slds-modal__container .forceChatterPublisherPresentationPanel .container .cuf-content {
            height: 100%;
        }
    </aura:html>

    <c:softValidationDebugger recordId="{!v.recordId}"></c:softValidationDebugger>
</aura:component>