<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <formulas>
        <name>fQLIEndDate</name>
        <dataType>Date</dataType>
        <expression>IF(
  AND(NOT(ISBLANK({!$Record.Quote.StartDate})), {!$Record.Quote.Contract_Term_Months__c} &gt; 0),
  DATE(
    YEAR({!$Record.Quote.StartDate}) + FLOOR((MONTH({!$Record.Quote.StartDate}) + {!$Record.Quote.Contract_Term_Months__c} - 1) / 12),
    MOD(MONTH({!$Record.Quote.StartDate}) + {!$Record.Quote.Contract_Term_Months__c} - 1, 12) + 1,
    1
  ) - 1,
  null
)</expression>
    </formulas>
    <interviewLabel>QuoteLine (BeforeUpdate) {!$Flow.CurrentDateTime}</interviewLabel>
    <label>QuoteLine (BeforeUpdate)</label>
    <processMetadataValues>
        <name>BuilderType</name>
