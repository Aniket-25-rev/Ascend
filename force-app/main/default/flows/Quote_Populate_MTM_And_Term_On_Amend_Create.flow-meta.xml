<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_MTM_And_Restore_Prior_Term</name>
        <label>Assign MTM and Restore Prior Term</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Month_to_Month__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Contract.Month_to_Month__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Contract_Term_Months__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record__Prior.Contract_Term_Months__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_MTM_And_Term</name>
        <label>Assign Month-to-Month and Contract Term</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Month_to_Month__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Contract.Month_to_Month__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Contract_Term_Months__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Contract.ContractTerm</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_Prior_Term</name>
        <label>Does a Prior Term Exist?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_MTM_And_Term</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Prior Term (Create) — Assign Term From Contract</defaultConnectorLabel>
        <rules>
            <name>Prior_Term_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Contract_Term_Months__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_MTM_And_Restore_Prior_Term</targetReference>
            </connector>
            <label>Prior Term Exists (Update) — Restore It</label>
        </rules>
    </decisions>
    <description>When an Amend Quote is created, copies Month_to_Month__c and ContractTerm from the linked Contract so that the Quote starts with the correct MTM flag and term. On re-fire during reprice, restores the user-set term via $Record__Prior to prevent Revenue Cloud overwriting it. Runs BeforeSave so no separate DML is needed.</description>
    <environments>Default</environments>
    <interviewLabel>Quote Populate MTM And Term On Amend Create {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Quote — Populate Month-to-Month and Term on Amend Create</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Contract</name>
        <label>Get Contract</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Prior_Term</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ContractId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contract</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Month_to_Month__c</queriedFields>
        <queriedFields>ContractTerm</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Contract</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OriginalActionType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Amend</stringValue>
            </value>
        </filters>
        <filters>
            <field>OriginalActionType</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>ContractId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Quote</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
