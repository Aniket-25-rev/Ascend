<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cannot_Add_Tier_Without_Alliance</fullName>
    <active>false</active>
    <errorConditionFormula>AND( Alliance__c = false, NOT(ISBLANK(TEXT( Re_Sale_Partner_Tier__c ))))</errorConditionFormula>
    <errorMessage>Re-Sale Partner Tier cannot be populated if Alliance is not marked as true</errorMessage>
</ValidationRule>
