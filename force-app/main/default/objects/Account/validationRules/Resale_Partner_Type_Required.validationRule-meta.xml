<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Resale_Partner_Type_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(INCLUDES(Alliance_Type__c, &quot;Re-sale partner&quot;), ISBLANK(TEXT(Re_Sale_Partner_Tier__c)))</errorConditionFormula>
    <errorMessage>Please specify a Re-Sale Partner Tier when Re-Sale Partner is selected as an Alliance Type</errorMessage>
</ValidationRule>
