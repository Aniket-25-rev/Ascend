<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_Auto_Reply_Cases</fullName>
    <active>true</active>
    <errorConditionFormula>BEGINS(Subject, &apos;Automatic reply&apos;)</errorConditionFormula>
    <errorMessage>Case cannot start with Automatic reply.</errorMessage>
</ValidationRule>
