<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Auto_Renew_Requires_Increase_Percent</fullName>
    <active>false</active>
    <errorConditionFormula>AND(Auto_Renew__c, ISNULL(Auto_Renew_Increase__c))</errorConditionFormula>
    <errorDisplayField>Auto_Renew_Increase__c</errorDisplayField>
    <errorMessage>Auto Renew % Increase must be populated when Auto Renew is checked.</errorMessage>
</ValidationRule>
