<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Fixed_Term_Restrict_Contract_Term_Edit</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    NOT(ISNEW()),
    ISCHANGED(ContractTerm),
    NOT(Month_to_Month__c)
)</errorConditionFormula>
    <errorDisplayField>ContractTerm</errorDisplayField>
    <errorMessage>Contract Term is derived from the Quote&apos;s Pricing Term Count while this Contract is not Month-to-Month and cannot be edited manually.</errorMessage>
</ValidationRule>
