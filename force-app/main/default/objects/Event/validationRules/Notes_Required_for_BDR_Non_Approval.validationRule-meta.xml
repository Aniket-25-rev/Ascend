<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Notes_Required_for_BDR_Non_Approval</fullName>
    <active>true</active>
    <errorConditionFormula>AND(TEXT(BDR_Appointment_Approved__c) = &quot;False&quot;, ISBLANK(BDR_Approval_Notes__c))</errorConditionFormula>
    <errorMessage>BDR Approval Notes Must be Completed for Approval = False</errorMessage>
</ValidationRule>
