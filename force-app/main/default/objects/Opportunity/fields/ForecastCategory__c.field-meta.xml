<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ForecastCategory__c</fullName>
    <inlineHelpText>Custom field to control manual override of standard Forecast Category; Best Case – Choose if confident that the deal will be won but have yet to receive a &quot;verbal&quot; from the client. Commit – Choose if the client has given us a &quot;verbal&quot; that the deal will be awarded to us.</inlineHelpText>
    <label>Forecast Category</label>
    <required>false</required>
    <trackFeedHistory>false</trackFeedHistory>
    <trackHistory>true</trackHistory>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Omitted</fullName>
                <default>false</default>
                <label>Omitted</label>
            </value>
            <value>
                <fullName>Pipeline</fullName>
                <default>true</default>
                <label>Pipeline</label>
            </value>
            <value>
                <fullName>Best Case</fullName>
                <default>false</default>
                <label>Best Case</label>
            </value>
            <value>
                <fullName>Commit</fullName>
                <default>false</default>
                <label>Commit</label>
            </value>
            <value>
                <fullName>Closed</fullName>
                <default>false</default>
                <label>Closed</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
