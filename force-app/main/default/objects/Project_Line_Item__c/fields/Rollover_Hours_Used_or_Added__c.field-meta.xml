<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Rollover_Hours_Used_or_Added__c</fullName>
    <externalId>false</externalId>
    <formula>IF(Rollover_Hours__c &lt; 0, 
   MIN(Billable_Hours_Remaining__c, ABS(Rollover_Hours__c)) , 
			IF(Billable_Hours_Worked__c&gt;(BaseHours__c + CarryoverHours__c), 
                 BaseHours__c+CarryoverHours__c-Billable_Hours_Worked__c, 
                 0) 
			)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Negative value means we used some of the available rollover hours we started the month with OR we added to the deficit. Positive value means we under used the available hours and we are reducing the deficit.</inlineHelpText>
    <label>Rollover Hours Used or Added</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
