<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Net_TCV__c</fullName>
    <description>NET set. Derived, not stored: a renewal restates the book so Net equals Current; every other action type is Current plus Existing.</description>
    <formula>IF(
  TEXT(OriginalActionType) = &quot;Renew&quot;,
  NULLVALUE(Current_TCV__c, 0),
  NULLVALUE(Current_TCV__c, 0) + NULLVALUE(Existing_TCV__c, 0)
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Net TCV</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Currency</type>
</CustomField>
