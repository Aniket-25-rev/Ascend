<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Minimum_Dollar_Enforcement_Monitoring</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    NOT(ISNEW()),
    NOT(ISBLANK(XMonitoring_Fee__c)),
    (XMonitoring_Fee__c/ Contract_Term_Months__c)  &lt; 350
)</errorConditionFormula>
    <errorMessage>Combined monthly total of Monitoring Lines cannot be less than $350.</errorMessage>
</ValidationRule>
