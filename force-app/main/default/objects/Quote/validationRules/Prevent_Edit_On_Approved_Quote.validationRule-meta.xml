<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_Edit_On_Approved_Quote</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Status, &quot;Approved&quot;),
  NOT(ISNEW()),
  ISPICKVAL(PRIORVALUE(Status), &quot;Approved&quot;),
  NOT($Permission.Bypass_Quote_Lock)
)</errorConditionFormula>
    <errorMessage>This Quote has been Approved and cannot be modified.</errorMessage>
</ValidationRule>
