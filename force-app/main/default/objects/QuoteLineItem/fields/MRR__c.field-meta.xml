<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>MRR__c</fullName>
    <description>Calculates the Monthly Recurring Revenue for the Quote Line Item by multiplying the Quantity by the Net Unit Price.</description>
    <formula>IF( PricingTermCount &gt;0, NetUnitPrice *  Quantity, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>MRR</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <type>Currency</type>
</CustomField>
