<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Entitlement_Quantity_can_not_be_less</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Entitlement_Quantity__c)),
    Entitlement_Quantity__c &lt; Quantity
)</errorConditionFormula>
    <errorDisplayField>Entitlement_Quantity__c</errorDisplayField>
    <errorMessage>Entitlement Quantity cannot be less than the line quantity.</errorMessage>
</ValidationRule>
