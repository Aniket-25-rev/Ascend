<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>hoursRemainingDifference__c</fullName>
    <description>returns true if hours remaining does not equal billable remaining from sow</description>
    <formula>if (AND(Hours_Remaining__c!=Billable_Remaining_From_SOW__c, Text(Project_Type__c)=&quot;Project&quot;),TRUE,FALSE)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>hoursRemainingDifference</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
