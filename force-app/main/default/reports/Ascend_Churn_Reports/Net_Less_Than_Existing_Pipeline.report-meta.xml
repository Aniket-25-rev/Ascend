    <description>Open opportunities whose quote prices below the existing contract baseline (Net &lt; Existing). Grouped by Opportunity Type then Stage. NOTE: the per-LOB Net MRR columns do not sum to total Net MRR, because bundle parent lines carry a blank LOB and are therefore excluded from every LOB column while still counting in the total.</description>
    <filter>
        <booleanFilter>1 AND 2 AND 3</booleanFilter>
        <criterias>
            <column>Opportunity$StageName</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>Closed Won,Closed Lost</value>
        </criterias>
        <criterias>
            <column>Opportunity$Type</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Renewal,Change Order,Full Churn,LOB Churn,Services Reduction</value>
        </criterias>
        <criterias>
            <column>Opportunity.Quotes$Net_Less_Than_Existing__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
            <value>1</value>
        </criterias>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Opportunity$Type</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>Opportunity$StageName</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Net Less Than Existing - Open Pipeline</name>
    <reportType>Opportunities_with_Quotes_RT</reportType>
    <scope>organization</scope>
    <showDetails>true</showDetails>
