<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <fieldUpdates>
        <fullName>Set_Estimated_Hours_for_BD_AD_Project</fullName>
        <field>Est_Hours__c</field>
        <formula>Case( Effort_Estimate__c ,
1, 1.5,
3, 3.5,
5, 7,
8, 10,
13, 15.5,
21, 25,
30, 34.5,
0)</formula>
        <name>Set Estimated Hours for BD AD Project</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <rules>
        <fullName>Set Estimated Hours for BD AD Project</fullName>
        <actions>
            <name>Set_Estimated_Hours_for_BD_AD_Project</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Project_Line_Item__c.External_ID__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Project_Line_Item__c.Effort_Estimate__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>SFDC_Projects__c.Name</field>
            <operation>startsWith</operation>
            <value>BD - SOW 69</value>
        </criteriaItems>
        <triggerType>onAllChanges</triggerType>
    </rules>
</Workflow>
