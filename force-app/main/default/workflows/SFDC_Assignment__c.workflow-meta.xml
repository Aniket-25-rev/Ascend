    <fieldUpdates>
        <fullName>Set_Assignment_Name</fullName>
        <field>Name</field>
        <formula>Left(CASE (TEXT(Role__c),
&quot;Travel&quot;,Resource__r.FirstName &amp; &apos; &apos; &amp;  Resource__r.LastName &amp; &apos; -Travel- &apos; &amp; Projects__r.Name,
&quot;Sales Engineer&quot;,
Resource__r.FirstName &amp; &apos; &apos; &amp;  Resource__r.LastName &amp; &apos; - &apos; &amp;  Opportunity__r.Name,
Resource__r.FirstName &amp; &apos; &apos; &amp;  Resource__r.LastName &amp;&apos; - &apos; &amp; BlankValue(Projects__r.Name, &quot;Opp: &quot; &amp; Opportunity__r.Name)), 80)</formula>
        <name>Set Assignment Name</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <rules>
        <fullName>Assignment Defaults</fullName>
        <actions>
            <name>Set_Assignment_Name</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <formula>true</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
</Workflow>
